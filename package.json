{
	"name": "highseam",
	"version": "1.1.0",
	"description": "A config-driven CMS for SvelteKit that runs at the edge and can sit on top of the database you already have. One config file generates the data layer, REST + GraphQL APIs, and a full admin panel. Runs on Node and Cloudflare Workers (D1 + R2).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/inkovic/highseam.git"
	},
	"homepage": "https://github.com/inkovic/highseam#readme",
	"bugs": {
		"url": "https://github.com/inkovic/highseam/issues"
	},
	"keywords": [
		"cms",
		"sveltekit",
		"svelte",
		"cloudflare",
		"workers",
		"d1",
		"r2",
		"headless-cms",
		"edge",
		"admin-panel"
	],
	"type": "module",
	"bin": {
		"highseam-init": "./bin/init.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*.svelte": {
			"types": "./dist/*.svelte.d.ts",
			"svelte": "./dist/*.svelte",
			"default": "./dist/*.svelte"
		},
		"./*.js": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"svelte": "./dist/*.js",
			"default": "./dist/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"templates",
		"bin",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"svelte": "./dist/index.js",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
		"generate:types": "curl -s -X POST http://localhost:5173/api/generate-types",
		"test:richtext": "node scripts/test-richtext-split.mjs",
		"test:media": "node --experimental-strip-types scripts/test-media.mjs",
		"test": "npm run test:richtext && npm run test:media",
		"package": "svelte-kit sync && svelte-package -o dist && node scripts/build-templates.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prepublishOnly": "npm test && npm run package"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.9.2",
		"jsdom": "^28.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.99.0"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20260610.1",
		"@lucide/svelte": "^1.17.0",
		"graphql": "^16.14.2"
	}
}
